# Isolated amd64 fresh-intake image; no legacy UI, scheduler, or external tagger CLI.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS builder
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
RUN uv sync --package yubal-api --no-dev --frozen --no-cache --no-editable

FROM python:3.12-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl xz-utils ca-certificates \
    && curl -fsSL --retry 3 -o /tmp/ffmpeg.tar.xz \
       https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz \
    && echo 'abda8d77ce8309141f83ab8edf0596834087c52467f6badf376a6a2a4c87cf67  /tmp/ffmpeg.tar.xz' | sha256sum -c - \
    && tar -xJf /tmp/ffmpeg.tar.xz --strip-components=1 -C /usr/local/bin \
       --wildcards '*/ffmpeg' '*/ffprobe' \
    && rm /tmp/ffmpeg.tar.xz \
    && apt-get purge -y curl xz-utils \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 2000 storage \
    && useradd -u 1000 -g 2000 -d /app -s /usr/sbin/nologin yubal
COPY --from=builder --chown=1000:2000 /app/.venv /app/.venv
COPY --chown=1000:2000 scripts/ ./scripts/
ENV PATH=/app/.venv/bin:$PATH \
    YUBAL_ROOT=/app \
    YUBAL_CONFIG=/state \
    YUBAL_DATA=/unused \
    YUBAL_INTAKE_ONLY=true \
    YUBAL_INTAKE_WORKER_ENABLED=false \
    YUBAL_INTAKE_STAGING=/staging \
    YUBAL_HOST=0.0.0.0 \
    YUBAL_PORT=8000
RUN python -c 'from yubal_api.api.app import create_app; app = create_app(); assert "/v1/intakes" in app.openapi()["paths"]; assert str(app.url_path_for("dashboard")) == "/"' \
    && ffprobe -version >/dev/null \
    && ffmpeg -version >/dev/null
USER 1000:2000
RUN python -c 'import os, sqlite3, tempfile; tmp = tempfile.TemporaryDirectory(); os.environ["YUBAL_CONFIG"] = tmp.name; from yubal_api.api.app import run_migrations; from yubal_api.settings import get_settings; run_migrations(); connection = sqlite3.connect(get_settings().db_path); assert {"source_tracks", "downstream_stages", "intake_devices"}.issubset({row[1] for row in connection.execute("PRAGMA table_list")}); connection.close(); tmp.cleanup()'
EXPOSE 8000
CMD ["python", "-m", "yubal_api"]
