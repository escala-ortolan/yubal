# Fresh-intake API and React UI.
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS web-builder
WORKDIR /web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web/ ./
ARG VITE_COMMIT_SHA=uncommitted
ENV VITE_INTAKE_ONLY=true VITE_VERSION=intake-ui VITE_COMMIT_SHA=$VITE_COMMIT_SHA VITE_IS_RELEASE=false
RUN bun run build

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS builder
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
RUN uv sync --package yubal-api --no-dev --frozen --no-cache --no-editable

FROM python:3.12-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl xz-utils ca-certificates \
    && curl -fsSL --retry 3 -o /tmp/ffmpeg.tar.xz \
       https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz \
    && echo 'abda8d77ce8309141f83ab8edf0596834087c52467f6badf376a6a2a4c87cf67  /tmp/ffmpeg.tar.xz' | sha256sum -c - \
    && tar -xJf /tmp/ffmpeg.tar.xz --strip-components=1 -C /usr/local/bin \
       --wildcards '*/ffmpeg' '*/ffprobe' \
    && rm /tmp/ffmpeg.tar.xz \
    && apt-get purge -y curl xz-utils \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 2000 storage \
    && useradd -u 1000 -g 2000 -d /app -s /usr/sbin/nologin yubal
COPY --from=builder --chown=1000:2000 /app/.venv /app/.venv
COPY --chown=1000:2000 scripts/ ./scripts/
COPY --from=web-builder --chown=1000:2000 /web/dist /app/web/dist
ENV PATH=/app/.venv/bin:$PATH \
    YUBAL_ROOT=/app \
    YUBAL_CONFIG=/state \
    YUBAL_DATA=/unused \
    YUBAL_INTAKE_ONLY=true \
    YUBAL_INTAKE_WORKER_ENABLED=false \
    YUBAL_INTAKE_STAGING=/staging \
    YUBAL_HOST=0.0.0.0 \
    YUBAL_PORT=8000
RUN python -c 'from yubal_api.api.app import create_app; app = create_app(); assert "/v1/intakes" in app.openapi()["paths"]; assert any(getattr(route, "name", None) == "spa" for route in app.routes)' \
    && ffprobe -version >/dev/null \
    && ffmpeg -version >/dev/null
USER 1000:2000
RUN python -c 'import os, sqlite3, tempfile; tmp = tempfile.TemporaryDirectory(); os.environ["YUBAL_CONFIG"] = tmp.name; from yubal_api.api.app import run_migrations; from yubal_api.settings import get_settings; run_migrations(); connection = sqlite3.connect(get_settings().db_path); tables = {row[1] for row in connection.execute("PRAGMA table_list")}; columns = {row[1] for row in connection.execute("PRAGMA table_info(source_tracks)")}; assert {"source_tracks", "downstream_stages", "intake_devices", "intake_controls", "intake_actions", "intake_schedules"}.issubset(tables); assert {"title", "artist"}.issubset(columns); connection.close(); tmp.cleanup()'
EXPOSE 8000
CMD ["python", "-m", "yubal_api"]
