{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Standard error response format.",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health check response model.",
        "properties": {
          "status": {
            "const": "healthy",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IntakeHistoryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/IntakeResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before"
          }
        },
        "required": [
          "items",
          "next_before"
        ],
        "title": "IntakeHistoryResponse",
        "type": "object"
      },
      "IntakeItemResponse": {
        "properties": {
          "downstream_status": {
            "enum": [
              "not_started",
              "waiting_for_tagger",
              "tagged",
              "filed",
              "missing_output"
            ],
            "title": "Downstream Status",
            "type": "string"
          },
          "final_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Path"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "downloading",
              "downloaded",
              "failed",
              "missing_output"
            ],
            "title": "Status",
            "type": "string"
          },
          "video_id": {
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "position",
          "video_id",
          "status",
          "downstream_status"
        ],
        "title": "IntakeItemResponse",
        "type": "object"
      },
      "IntakeRequest": {
        "additionalProperties": false,
        "properties": {
          "capture_session_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capture Session Id"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "manual_song",
              "manual_queue",
              "manual_playlist"
            ],
            "title": "Mode",
            "type": "string"
          },
          "queue_revision": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Revision"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "source_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/IntakeTrack"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Tracks",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "device_id",
          "mode",
          "tracks"
        ],
        "title": "IntakeRequest",
        "type": "object"
      },
      "IntakeResponse": {
        "properties": {
          "intake_id": {
            "format": "uuid",
            "title": "Intake Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/IntakeItemResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "intake_id",
          "items"
        ],
        "title": "IntakeResponse",
        "type": "object"
      },
      "IntakeTrack": {
        "additionalProperties": false,
        "properties": {
          "artist_hint": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artist Hint"
          },
          "position": {
            "maximum": 99.0,
            "minimum": 0.0,
            "title": "Position",
            "type": "integer"
          },
          "title_hint": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title Hint"
          },
          "video_id": {
            "pattern": "^[A-Za-z0-9_-]{11}$",
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id",
          "position"
        ],
        "title": "IntakeTrack",
        "type": "object"
      },
      "SourceContext": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "song",
              "queue",
              "playlist",
              "radio"
            ],
            "title": "Kind",
            "type": "string"
          },
          "playlist_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Playlist Id"
          }
        },
        "required": [
          "kind"
        ],
        "title": "SourceContext",
        "type": "object"
      },
      "TrackResponse": {
        "properties": {
          "downstream_status": {
            "enum": [
              "not_started",
              "waiting_for_tagger",
              "tagged",
              "filed",
              "missing_output"
            ],
            "title": "Downstream Status",
            "type": "string"
          },
          "final_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Path"
          },
          "status": {
            "enum": [
              "pending",
              "downloading",
              "downloaded",
              "failed",
              "missing_output"
            ],
            "title": "Status",
            "type": "string"
          },
          "video_id": {
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id",
          "status",
          "downstream_status"
        ],
        "title": "TrackResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "YouTube Music Downloader API",
    "title": "yubal",
    "version": "0.10.0"
  },
